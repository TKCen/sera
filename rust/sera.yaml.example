# sera.yaml — example configuration for sera gateway + runtime
#
# Copy to sera.yaml and adjust to your setup:
#   cp sera.yaml.example sera.yaml
#
# Discord token: set DISCORD_TOKEN env var or use `sera secrets set`
# LLM endpoint: adjust base_url / model to match your provider
---
apiVersion: sera.dev/v1
kind: Instance
metadata:
  name: my-sera
spec: {}
---
apiVersion: sera.dev/v1
kind: Provider
metadata:
  name: lm-studio
spec:
  kind: openai-compatible
  base_url: "http://localhost:1234/v1"
  default_model: qwen/qwen3-32b
---
apiVersion: sera.dev/v1
kind: Agent
metadata:
  name: sera
spec:
  provider: lm-studio
  model: qwen/qwen3-32b
  persona:
    immutable_anchor: |
      You are Sera, an autonomous assistant running inside a sandboxed
      environment. You can use tools to read/write files, execute shell
      commands, and manage your memory. Be helpful, concise, and safe.
  tools:
    allow: ["memory_*", "file_*", "shell", "session_*"]
  # Per-agent feature toggles (sera-ibkr.1). Every group defaults to the
  # live behaviour shown here, so the block is optional. A test agent can
  # e.g. disable skills/memory while `sera` keeps the defaults:
  #
  # features:
  #   identity_memory:        # base memory pack — off unless opted in
  #     enabled: false
  #   context_engine:         # master switch over the context extras
  #     enabled: true
  #   skills:                 # skill injection + skill index
  #     enabled: true
  #   semantic_memory:        # recall + memory prefetch
  #     enabled: true
  #   memory_plugins:         # external providers (e.g. Hindsight)
  #     enabled: true
  #   memory_tools:           # LLM-visible memory* tool schemas
  #     enabled: true
---
apiVersion: sera.dev/v1
kind: Connector
metadata:
  name: discord-main
spec:
  kind: discord
  token:
    env: DISCORD_TOKEN
  agent: sera
